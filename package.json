{
  "name": "dataset-commons",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "description": "Civitai App (page money path) \u2014 estimate -> consent -> submit -> poll -> real Buzz spend, wired to the published App SDK.",
  "license": "MIT",
  "scripts": {
    "postinstall": "node -e \"console.log('\\n\u2713 Installed. Next: npm run dev:harness   (preview \u2014 mock host, no Buzz)\\n  real generation: civitai app dev-token <slug> -> npm run dev:live (no submit needed; see README)   \u00b7   publish: civitai app submit')\"",
    "dev": "vite",
    "dev:harness": "VITE_DEV_HARNESS=true VITE_HARNESS_MODE=mock vite --host localhost --port 5186",
    "dev:live": "VITE_DEV_HARNESS=true VITE_HARNESS_MODE=live vite --host localhost --port 5186",
    "dev:tunnel": "CIVITAI_DEV_TUNNEL_HMR=1 vite --host localhost --port 5186 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@civitai/app-sdk": "^0.57.0",
    "@civitai/blocks-react": "^0.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
